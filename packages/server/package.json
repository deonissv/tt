{
  "name": "@tt/server",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "npm run options -- npx webpack --config ./webpack.config.js --env production",
    "dev": "npm run options -- npx webpack --config ./webpack.config.js --watch",
    "lint": "eslint --ext .ts src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:w": "vitest --config ../../vitest.config.ts",
    "test:e2e": "vitest run --config ../../vitest.e2e.config.ts",
    "test:e2e:fast": "cross-env TESTCONTAINERS_REUSE_ENABLE=true vitest run --config ../../vitest.e2e.config.ts",
    "typecheck": "tsc --build --noEmit",
    "start": "npm run options -- node ../../build/main.js",
    "debug": "nest start --debug --watch -e 'node --experimental-require-module'",
    "db:gen": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "options": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-modules --experimental-wasm-modules --experimental-require-module --experimental-vm-modules \" NODE_NO_WARNINGS=1 ",
    "env": "dotenv -e ./../../.env"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^7.18.0",
    "@babylonjs/havok": "^1.3.7",
    "@babylonjs/loaders": "^7.18.0",
    "@casl/ability": "^6.8.3",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-ws": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^5.17.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "prisma-extension-soft-delete": "1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "unplugin-swc": "1.5.9",
    "ws": "^8.22.1",
    "body-parser": "^2.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.17.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.14.0",
    "webpack-cli": "^5.1.4",
    "dotenv-cli": "^7.4.2",
    "vitest": "^4.1.12"
  }
}
